# Backend API address
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Shown in the Privacy Policy and Terms (data controller, GDPR Art. 13).
# Leave the name empty to show a generic "the author of the application".
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=contact@example.com
# Optional, once the app is hosted publicly (e.g. "Hetzner Online GmbH, Germany")
NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
# Optional: the service that sends the app's emails (e.g. "Brevo (Sendinblue SAS, France)"); default text: Google Gmail
NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER=

# true = public demo: demo accounts on the sign-in page and notices for visitors
NEXT_PUBLIC_SHOWCASE=false
