# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origin allowed by CORS (required in production)
FRONTEND_URL=http://localhost:3000
# Set to true when running behind a reverse proxy (nginx, PaaS) so rate limiting sees the real client IP
TRUST_PROXY=false
# API docs at /api/docs are always on in development; in production only if enabled here
SWAGGER_ENABLED=false
# Global rate limit: requests per minute per IP (auth routes have stricter built-in limits)
THROTTLE_LIMIT=300

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=uniproject
# Schema is managed by migrations (npm run migration:run, also run automatically on start).
# true = TypeORM syncs the schema from entities on start — quick local prototyping only, never in production.
DB_SYNCHRONIZE=false
# Log every SQL query
DB_LOGGING=false
# Encrypted connection, required by hosted databases (e.g. Supabase)
DB_SSL=false

# ─── Authentication ──────────────────────────────────────────────────────
# Two different random secrets, at least 32 characters each. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email ───────────────────────────────────────────────────────────────
# Leave MAIL_USER empty in development: emails (including verification codes) are printed in the backend console.
MAIL_USER=
# For Gmail use an app password, not the account password
MAIL_PASS=
# Optional: any SMTP server instead of Gmail
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
# Sender address, if different from MAIL_USER (e.g. Brevo uses a separate SMTP login)
MAIL_FROM=

# ─── File uploads ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
# Maximum size of a project document, in bytes (50 MB)
MAX_FILE_SIZE=52428800

# ─── Demo data (npm run seed) ────────────────────────────────────────────
# Optional real address for the demo student account, to receive emails locally
SEED_DEMO_EMAIL=
# Admin password for the demo data (default: password123; random in showcase mode)
SEED_ADMIN_PASSWORD=

# ─── Public demo ─────────────────────────────────────────────────────────
# true = shared demo accounts can't change password/PIN or be deleted, professors don't need approval,
# and the demo data (including visitors' accounts) is reloaded every night. Use with `npm run start:showcase`.
SHOWCASE_MODE=false

# Video calls (Jitsi Meet). Use your own Jitsi server if you have one
JITSI_BASE_URL=https://meet.jit.si
