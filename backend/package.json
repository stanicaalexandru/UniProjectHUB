{
  "name": "uniproject-backend",
  "version": "1.0.0",
  "description": "UniProject Hub - Backend API NestJS + PostgreSQL",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "node --test test/*.test.mjs",
    "seed": "ts-node src/database/seed.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "seed:prod": "node dist/database/seed.js",
    "start:showcase": "npm run migration:run:prod && npm run seed:prod && node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.12",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.2",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^3.0.13",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.0"
  }
}
